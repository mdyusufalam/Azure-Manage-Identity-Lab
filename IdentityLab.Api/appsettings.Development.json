{
  // Local overrides. Point these at real dev resources you (your `az login`
  // user) have the roles for. This file is safe to keep endpoint URLs in -
  // there are still no secrets here.
  "Azure": {
    "AppConfig": {
      "Endpoint": "https://az-204-app-config-lab.azconfig.io"
    },
    "Storage": {
      "AccountName": "stlab204",
      "ContainerName": "uploads"
    },
    "EventGrid": {
      "TopicEndpoint": "https://az-204-event-grid-lab.centralindia-1.eventgrid.azure.net/api/events"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // Uncomment to watch DefaultAzureCredential pick a credential source.
      "Azure.Identity": "Debug",
      "Azure": "Warning"
    }
  }
}
