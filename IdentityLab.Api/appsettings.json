{
  // -------------------------------------------------------------------------
  // The ONLY Azure values in this file are endpoint URLs and a storage account
  // name. No keys, no connection strings, no client secrets - every Azure call
  // authenticates with DefaultAzureCredential (managed identity in Azure, your
  // `az login` locally).
  //
  // .NET's JSON configuration provider allows these // comments.
  // -------------------------------------------------------------------------
  "Azure": {
    "AppConfig": {
      // Azure App Configuration endpoint. Portal: App Configuration resource
      // -> Overview -> Endpoint. Leave blank to skip App Configuration entirely
      // (then /api/config/demo returns 503).
      "Endpoint": "https://REPLACE-ME.azconfig.io"
    },
    "Storage": {
      // Storage account NAME only (not a URL, not a connection string). The blob
      // endpoint https://<name>.blob.core.windows.net is derived in Program.cs.
      "AccountName": "REPLACEME",
      // Blob container that uploads land in. Created on first upload if missing.
      "ContainerName": "uploads"
    },
    "EventGrid": {
      // Event Grid TOPIC endpoint (custom topic). Portal: Event Grid Topic
      // -> Overview -> Topic Endpoint, e.g.
      // https://REPLACE-ME.<region>-1.eventgrid.azure.net/api/events
      "TopicEndpoint": "https://REPLACE-ME.region-1.eventgrid.azure.net/api/events"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
